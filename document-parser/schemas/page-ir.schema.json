{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/document-parser/page-ir.schema.json",
  "title": "ParsedDocument Page IR",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_manifest", "pages", "engine_manifest", "validation_summary"],
  "properties": {
    "document_manifest": {
      "type": "object",
      "additionalProperties": true,
      "required": ["book_id", "page_count"],
      "properties": {
        "book_id": {
          "type": "string"
        },
        "page_count": {
          "type": "integer",
          "minimum": 1
        },
        "profile_hint": {
          "type": "string"
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "engine_manifest": {
      "type": "object",
      "additionalProperties": true
    },
    "validation_summary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_valid", "coordinate_missing_node_count", "reading_order_cycle_count"],
      "properties": {
        "schema_valid": {
          "type": "boolean"
        },
        "coordinate_missing_node_count": {
          "type": "integer",
          "minimum": 0
        },
        "reading_order_cycle_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "contentType": {
      "type": "string",
      "enum": ["TEXT", "MATH", "TABLE", "UNSUPPORTED_VISUAL", "UNKNOWN"]
    },
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "normalizedBbox": {
      "allOf": [
        {
          "$ref": "#/$defs/bbox"
        },
        {
          "properties": {
            "x": {
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "minimum": 0,
              "maximum": 1
            },
            "width": {
              "minimum": 0,
              "maximum": 1
            },
            "height": {
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      ]
    },
    "issue": {
      "$ref": "parse-issue.schema.json"
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["span_type"],
      "properties": {
        "span_type": {
          "type": "string",
          "enum": ["TEXT", "MATH_REF", "UNKNOWN"]
        },
        "text": {
          "type": "string"
        },
        "math_node_id": {
          "type": "string"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "node_id",
        "content_type",
        "bbox",
        "normalized_bbox",
        "confidence",
        "source_engine",
        "issues"
      ],
      "properties": {
        "node_id": {
          "type": "string"
        },
        "content_type": {
          "$ref": "#/$defs/contentType"
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "normalized_bbox": {
          "$ref": "#/$defs/normalizedBbox"
        },
        "reading_order_index": {
          "type": "integer",
          "minimum": 0
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source_engine": {
          "type": "string"
        },
        "source_crop_ref": {
          "type": "string"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "raw_text": {
          "type": "string"
        },
        "normalized_text": {
          "type": "string"
        },
        "spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          }
        },
        "raw_formula": {
          "type": "string"
        },
        "formula_format": {
          "type": "string",
          "enum": ["LATEX", "MATHML", "UNKNOWN"]
        },
        "presentation_ast": {
          "$ref": "math-ast.schema.json"
        },
        "table_ir": {
          "$ref": "table-ir.schema.json"
        },
        "visual_type_candidate": {
          "type": "string"
        },
        "embedded_text_nodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_id", "page_geometry", "nodes", "reading_order", "parse_issues", "quality_report"],
      "properties": {
        "page_id": {
          "type": "string"
        },
        "page_geometry": {
          "type": "object",
          "additionalProperties": true,
          "required": ["width", "height"],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "reading_order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parse_issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "quality_report": {
          "type": "object",
          "additionalProperties": true,
          "required": ["status"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["PASS", "PASS_WITH_CORRECTION", "LOW_QUALITY", "REJECTED"]
            }
          }
        }
      }
    }
  }
}

