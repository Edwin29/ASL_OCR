{"t": 259196.828, "phase": "initial", "kind": "debug", "text": "========================================\r\n"}
{"t": 259196.828, "phase": "initial", "kind": "debug", "text": " BRAILLE DISPLAY - HC05 + GITHUB NAV\r\n"}
{"t": 259196.828, "phase": "initial", "kind": "debug", "text": " PCA1=TOP / PCA2=BOTTOM\r\n"}
{"t": 259196.843, "phase": "initial", "kind": "debug", "text": "========================================\r\n"}
{"t": 259196.843, "phase": "initial", "kind": "debug", "text": "HC-05 UART = 9600 baud\r\n"}
{"t": 259196.843, "phase": "initial", "kind": "debug", "text": "PCA 0x40 FOUND\r\n"}
{"t": 259196.843, "phase": "initial", "kind": "debug", "text": "PCA 0x41 FOUND\r\n"}
{"t": 259196.859, "phase": "initial", "kind": "debug", "text": "PCA INIT OK\r\n"}
{"t": 259196.859, "phase": "initial", "kind": "debug", "text": "PCA1 0x41 CH9~0 = TOP/LEFT logical Cell1~10\r\n"}
{"t": 259196.875, "phase": "initial", "kind": "debug", "text": "PCA2 0x40 CH9~0 = BOTTOM/RIGHT logical Cell1~10\r\n"}
{"t": 259196.875, "phase": "initial", "kind": "debug", "text": "\r\n"}
{"t": 259196.875, "phase": "initial", "kind": "debug", "text": "BUTTONS\r\n"}
{"t": 259196.875, "phase": "initial", "kind": "debug", "text": "CN7-28 / PA0 = UP\r\n"}
{"t": 259196.875, "phase": "initial", "kind": "debug", "text": "CN7-30 / PA1 = DOWN\r\n"}
{"t": 259196.875, "phase": "initial", "kind": "debug", "text": "CN7-32 / PA4 = LEFT\r\n"}
{"t": 259196.875, "phase": "initial", "kind": "debug", "text": "CN7-34 / PB0 = RIGHT\r\n"}
{"t": 259196.875, "phase": "initial", "kind": "debug", "text": "CN10-24 / PB1 = PAGE NEXT\r\n"}
{"t": 259196.875, "phase": "initial", "kind": "debug", "text": "PB2 = PAGE PREVIOUS\r\n"}
{"t": 259196.89, "phase": "initial", "kind": "debug", "text": "PC0 = CONFIRM (release sends SHORT or LONG)\r\n"}
{"t": 259196.89, "phase": "initial", "kind": "debug", "text": "PC8 = MODE LEVER (LOW=capture, HIGH=reading)\r\n"}
{"t": 259196.89, "phase": "initial", "kind": "debug", "text": "Tap = 1 step\r\n"}
{"t": 259196.89, "phase": "initial", "kind": "debug", "text": "Hold >= 650ms = auto-repeat every 180ms\r\n"}
{"t": 259196.89, "phase": "initial", "kind": "debug", "text": "\r\n"}
{"t": 259196.89, "phase": "initial", "kind": "debug", "text": "BT: HELLO V3...\r\n"}
